# Copy to `.env` (never committed) and fill in what you need. Everything is optional for `az login` use.

# How the service signs in to Azure: cli | default | managed-identity   (compose defaults to "default")
# AIE_AZURE_AUTH=default

# When device-code login is blocked: run the token broker on the host and let it write the three settings below into .env
#   python -m routing_lab.token_broker --write-env .env        (leave it running; see docs/docker.md)
# AIE_AZURE_AUTH=managed-identity
# IDENTITY_ENDPOINT=http://host.docker.internal:8788/msi/token
# IDENTITY_HEADER=<random secret the broker generates>

# A service principal, instead of `az login`, for a server or CI. It needs access to the Azure ML endpoint and the Azure OpenAI resource.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# Other containers that call this service by name (adds their Host header to the allowed list)
# AIE_ALLOWED_HOSTS=my-other-app

# Use a different Clef endpoint than azure/online/connection.json
# CLEF_ENDPOINT_URL=https://<endpoint>.<region>.inference.ml.azure.com/score

# Run Clef from this repo's models/ folder in a container (compose profile "local-clef"; needs an NVIDIA GPU)
# AIE_SHADOW_LOCAL=1
# AIE_SHADOW_URL=http://clef-server:5001/score
# The Azure AI resource the agents call (required; not stored in the repository)
# AIE_LLM_ENDPOINT=https://<name>.services.ai.azure.com/openai/v1/
