# Normalize text to LF in the repository. The weights are not committed (see .gitignore); if you ever add them, GitHub rejects files over
# 100 MB without Git LFS, so keep these filters and run `git lfs install` first.
* text=auto eol=lf
models/**/*.safetensors filter=lfs diff=lfs merge=lfs -text
*.safetensors filter=lfs diff=lfs merge=lfs -text

# Scripts and container files must keep Unix line endings or Linux containers cannot run them.
*.sh text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf
docker/** text eol=lf
.dockerignore text eol=lf
docker-compose.yml text eol=lf
models/**/SHA256SUMS text eol=lf
