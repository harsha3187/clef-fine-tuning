# Fine-tuned Clef weights are large binary files: store them with Git LFS, not in normal git history.
# (GitHub rejects files over 100 MB without LFS.) Run `git lfs install` once per machine before the first commit.
models/**/*.safetensors filter=lfs diff=lfs merge=lfs -text
*.safetensors filter=lfs diff=lfs merge=lfs -text

# Scripts and container files must keep Unix line endings or Linux containers cannot run them.
*.sh text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf
docker/** text eol=lf
.dockerignore text eol=lf
docker-compose.yml text eol=lf
models/**/SHA256SUMS text eol=lf
