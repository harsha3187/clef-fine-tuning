   "updated": 1,
   "link": null,
   "locked": false,
   "text": "REAL DATA\nsearch_web: gpt-4.1 + built-in web\nsearch, cited URLs (max 8 per trip)\nget_destination_overview: Open-Meteo\ngeocoding + Wikivoyage\nget_weather: Open-Meteo forecast or\nsame dates last year\nsuggest_destinations: weather-ranked\nshortlist of 9 cities\nfind_hotels: names and stars from\nOpenStreetMap, rates estimated",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "tr",
   "originalText": "REAL DATA\nsearch_web: gpt-4.1 + built-in web\nsearch, cited URLs (max 8 per trip)\nget_destination_overview: Open-Meteo\ngeocoding + Wikivoyage\nget_weather: Open-Meteo forecast or\nsame dates last year\nsuggest_destinations: weather-ranked\nshortlist of 9 cities\nfind_hotels: names and stars from\nOpenStreetMap, rates estimated",
   "autoResize": true,
   "lineHeight": 1.25
  },
