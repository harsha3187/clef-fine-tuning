   "versionNonce": 2075,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "SIMULATED, labelled in every result\nsearch_flights: deterministic fares\nfrom distance, season and lead time\nhold_flight, hold_hotel: a hold id,\nnothing is booked or charged\n\nThe planner prompt tells sub-agents\nto call these and to quote offer ids,\nprices and URLs exactly",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "ts",
   "originalText": "SIMULATED, labelled in every result\nsearch_flights: deterministic fares\nfrom distance, season and lead time\nhold_flight, hold_hotel: a hold id,\nnothing is booked or charged\n\nThe planner prompt tells sub-agents\nto call these and to quote offer ids,\nprices and URLs exactly",
   "autoResize": true,
   "lineHeight": 1.25
  },
